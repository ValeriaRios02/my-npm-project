    <dependencies>
        <!-- Spring-web with RCE vulnerability - external dependency -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>5.0.0.RELEASE</version>
        </dependency>
    </dependencies>

</project>
